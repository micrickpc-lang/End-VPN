<Window x:Class="EndVPN.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="END VPN Setup"
        Width="960" Height="620"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="False"
        SourceInitialized="Window_SourceInitialized">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52"
                        CornerRadius="28"
                        GlassFrameThickness="-1"
                        ResizeBorderThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <CubicEase x:Key="SmoothEase" EasingMode="EaseOut" />

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="58" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
              </Grid.RenderTransform>
              <Border x:Name="ButtonGlow" Margin="5" CornerRadius="19" Opacity="0.7">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#8A2799E9" Offset="0" />
                    <GradientStop Color="#5D8A4CBF" Offset="0.54" />
                    <GradientStop Color="#7ED53658" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                  <BlurEffect Radius="20" />
                </Border.Effect>
              </Border>
              <Border x:Name="ButtonSurface" Margin="1" CornerRadius="18" BorderThickness="1" BorderBrush="#72FFFFFF">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E1268FD6" Offset="0" />
                    <GradientStop Color="#E2524178" Offset="0.52" />
                    <GradientStop Color="#E6A82B48" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Grid ClipToBounds="True">
                  <Border Height="24" VerticalAlignment="Top" CornerRadius="18,18,0,0" Background="#22FFFFFF" />
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonGlow" Property="Opacity" Value="1" />
                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="1.018" ScaleY="1.018" /></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.985" ScaleY="0.985" /></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.34" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="5,0,0,0" />
      <Setter Property="Foreground" Value="#D7E0E8" />
      <Setter Property="Background" Value="#12FFFFFF" />
      <Setter Property="BorderBrush" Value="#2BFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CaptionSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CaptionSurface" Property="Background" Value="#28FFFFFF" />
                <Setter TargetName="CaptionSurface" Property="BorderBrush" Value="#4DFFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CaptionSurface" Property="Opacity" Value="0.72" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AgreementCheckStyle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E7ECF2" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border x:Name="CheckSurface" CornerRadius="7" Background="#1CFFFFFF" BorderBrush="#4CFFFFFF" BorderThickness="1" />
                <Path x:Name="CheckMark" Data="M 5,11 L 9,15 L 17,6" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
              </Grid>
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckSurface" Property="Background" Value="#C12A8FD5" />
                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#A9AEE9FF" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#A0FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Width="7" Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="26">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ScrollThumb" Margin="1,0" CornerRadius="3" Background="#54B7C7D8" BorderBrush="#34FFFFFF" BorderThickness="1" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ScrollThumb" Property="Background" Value="#8C65C8F6" />
                            <Setter TargetName="ScrollThumb" Property="BorderBrush" Value="#79FFFFFF" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="WindowRoot" ClipToBounds="True">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#CF080B10" Offset="0" />
        <GradientStop Color="#D3101118" Offset="0.52" />
        <GradientStop Color="#D10A0B10" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>

    <Grid x:Name="AmbientVisual" IsHitTestVisible="False">
      <Ellipse Width="580" Height="580" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-280,-310,0,0" Opacity="0.68">
        <Ellipse.RenderTransform><TranslateTransform x:Name="BlueTransform" /></Ellipse.RenderTransform>
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#9B168EDB" Offset="0" />
            <GradientStop Color="#310B5B99" Offset="0.42" />
            <GradientStop Color="#00101A24" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.Effect><BlurEffect Radius="76" /></Ellipse.Effect>
      </Ellipse>
      <Ellipse Width="600" Height="600" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-330" Opacity="0.62">
        <Ellipse.RenderTransform><TranslateTransform x:Name="RedTransform" /></Ellipse.RenderTransform>
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#9BC52849" Offset="0" />
            <GradientStop Color="#382D101B" Offset="0.48" />
            <GradientStop Color="#00160C12" Offset="1" />
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.Effect><BlurEffect Radius="84" /></Ellipse.Effect>
      </Ellipse>
      <Path Data="M -80,525 L 1030,105" Stroke="#2D41B7F4" StrokeThickness="2" />
      <Path Data="M -80,555 L 1030,135" Stroke="#1F7D76C2" StrokeThickness="6" />
      <Path Data="M -80,586 L 1030,166" Stroke="#37DF3152" StrokeThickness="2" />
    </Grid>

    <Border Margin="18" CornerRadius="30" BorderThickness="1" BorderBrush="#47FFFFFF" Background="#36141921">
      <Border.Effect>
        <DropShadowEffect Color="#D9000000" BlurRadius="40" ShadowDepth="12" Opacity="0.55" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="62" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="25,9,17,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="38" Height="38" CornerRadius="12" Background="#28000000" BorderBrush="#35FFFFFF" BorderThickness="1">
              <Image Source="Assets/logo.png" Stretch="UniformToFill" />
            </Border>
            <TextBlock Text="END VPN" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="17" FontWeight="Bold" Foreground="White" />
            <Border Margin="11,0,0,0" Padding="9,4" CornerRadius="10" Background="#16FFFFFF" BorderBrush="#2CFFFFFF" BorderThickness="1">
              <TextBlock Text="SETUP  1.1" Foreground="#AEB9C5" FontSize="10" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="—" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click" />
            <Button x:Name="CloseButton" Content="×" Style="{StaticResource CaptionButtonStyle}" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="34,12,34,34">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="344" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" CornerRadius="27" BorderThickness="1" BorderBrush="#3DFFFFFF" Background="#4210151D">
            <Grid ClipToBounds="True">
              <Ellipse Width="260" Height="260" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="#101799E4">
                <Ellipse.Effect><BlurEffect Radius="28" /></Ellipse.Effect>
              </Ellipse>
              <Image Source="Assets/logo.png" Width="276" Height="276" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
              <Border VerticalAlignment="Bottom" Margin="24" Padding="15,12" CornerRadius="16" Background="#75101319" BorderBrush="#3EFFFFFF" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="8" Height="8" CornerRadius="4" Background="#46D5FF" VerticalAlignment="Center">
                    <Border.Effect><DropShadowEffect Color="#46D5FF" BlurRadius="10" ShadowDepth="0" Opacity="0.8" /></Border.Effect>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="11,0,0,0">
                    <TextBlock Text="SECURE  •  FAST  •  PRIVATE" FontSize="10" FontWeight="SemiBold" Foreground="#DCE4EC" />
                    <TextBlock Text="Защита начинается здесь" Margin="0,4,0,0" FontSize="11" Foreground="#84909E" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <Grid Grid.Column="2" Margin="3,2,1,2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="EyebrowText" Text="ШАГ 1 ИЗ 2" FontSize="10" FontWeight="Bold" Foreground="#63C9FF" />
                <TextBlock Text="  •  ПОДГОТОВКА" FontSize="10" FontWeight="Bold" Foreground="#7D8794" />
              </StackPanel>
              <TextBlock x:Name="TitleText" Text="Правила и оферта" Margin="0,8,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="32" FontWeight="Bold" Foreground="White" />
              <TextBlock x:Name="SubtitleText" Text="Ознакомьтесь с условиями перед установкой END VPN." Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#9DA7B4" FontSize="13" LineHeight="19" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,15,0,14">
              <Border x:Name="AgreementPanel" CornerRadius="18" Background="#38171D26" BorderBrush="#37FFFFFF" BorderThickness="1" Padding="16,13">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,9,0">
                    <StackPanel>
                      <TextBlock Text="Характер предоставления услуги" FontSize="12" FontWeight="Bold" Foreground="#EAF2F8" />
                      <TextBlock Text="Сервис предоставляет вычислительные ресурсы и сетевые шлюзы на условиях «как есть». Исполнитель не отвечает за сбои по вине государственных органов или интернет-провайдеров." Margin="0,4,0,11" TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="#AAB4C0" />

                      <TextBlock Text="Недопустимость противоправных действий" FontSize="12" FontWeight="Bold" Foreground="#EAF2F8" />
                      <TextBlock Text="Запрещены спам, несанкционированный взлом, запрещённые материалы и любые иные действия, противоречащие закону." Margin="0,4,0,11" TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="#AAB4C0" />

                      <TextBlock Text="Запрет перепродажи" FontSize="12" FontWeight="Bold" Foreground="#EAF2F8" />
                      <TextBlock Text="Передача приобретённых услуг или продуктов третьим лицам не разрешается." Margin="0,4,0,11" TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="#AAB4C0" />

                      <TextBlock Text="Приостановка доступа" FontSize="12" FontWeight="Bold" Foreground="#EAF2F8" />
                      <TextBlock Text="При нарушениях или подозрительных операциях администрация вправе заблокировать аккаунт без компенсации." Margin="0,4,0,11" TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="#AAB4C0" />

                      <TextBlock Text="Финансовые условия" FontSize="12" FontWeight="Bold" Foreground="#EAF2F8" />
                      <TextBlock Text="Платежи совершаются добровольно. Возврат средств и автопродление регулируются Публичной офертой." Margin="0,4,0,11" TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="#AAB4C0" />

                      <TextBlock Text="Обязанности пользователя" FontSize="12" FontWeight="Bold" Foreground="#EAF2F8" />
                      <TextBlock Text="Пользователь самостоятельно отвечает за сохранность ключей доступа и данных своей учётной записи." Margin="0,4,0,11" TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="#AAB4C0" />

                      <TextBlock Text="Техническая поддержка" FontSize="12" FontWeight="Bold" Foreground="#EAF2F8" />
                      <TextBlock Text="Вопросы по работе инфраструктуры следует направлять в официальный чат поддержки." Margin="0,4,0,2" TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="#AAB4C0" />
                    </StackPanel>
                  </ScrollViewer>
                  <Border Grid.Row="1" Margin="0,10,0,0" Padding="11,8" CornerRadius="12" Background="#181B94D7" BorderBrush="#302CAAEF" BorderThickness="1">
                    <TextBlock FontSize="11.5" Foreground="#B8DDFC">
                      <Hyperlink NavigateUri="https://telegra.ph/PUBLICHNAYA-OFERTA-End-VPN-04-17" RequestNavigate="OfferLink_RequestNavigate" Foreground="#75CCFF">Открыть полную Публичную оферту</Hyperlink>
                    </TextBlock>
                  </Border>
                </Grid>
              </Border>

              <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border CornerRadius="18" Background="#38171D26" BorderBrush="#37FFFFFF" BorderThickness="1">
                  <Grid>
                    <Ellipse Width="120" Height="120" Fill="#141F95D9" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Ellipse.Effect><BlurEffect Radius="24" /></Ellipse.Effect>
                    </Ellipse>
                    <Grid Width="92" Height="92" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Ellipse Stroke="#22FFFFFF" StrokeThickness="5" />
                      <Path x:Name="ProgressArc" Data="M 46,4 A 42,42 0 0 1 88,46" Stroke="#63C9FF" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Effect><DropShadowEffect Color="#43BAF4" BlurRadius="10" ShadowDepth="0" /></Path.Effect>
                        <Path.RenderTransform><RotateTransform x:Name="SpinnerRotate" CenterX="46" CenterY="46" /></Path.RenderTransform>
                      </Path>
                      <TextBlock x:Name="PercentText" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" />
                    </Grid>
                  </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,13,0,0">
                  <TextBlock x:Name="StatusText" Text="Подготовка…" FontSize="12" Foreground="#C8D0D9" />
                  <Border x:Name="ProgressTrack" Height="7" Margin="0,8,0,0" CornerRadius="4" Background="#22FFFFFF" ClipToBounds="True">
                    <Grid>
                      <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="4">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#48BDF4" />
                            <GradientStop Color="#A64A8B" Offset="0.55" />
                            <GradientStop Color="#E54863" Offset="1" />
                          </LinearGradientBrush>
                        </Border.Background>
                      </Border>
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>

              <Border x:Name="DonePanel" Visibility="Collapsed" CornerRadius="18" Background="#38171D26" BorderBrush="#37FFFFFF" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Border Width="78" Height="78" CornerRadius="39" Background="#2648C991" BorderBrush="#704DDBA0" BorderThickness="1">
                    <Path Data="M 20,40 L 34,54 L 59,26" Stroke="#7BE8B6" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  </Border>
                  <TextBlock Text="Установка завершена" Margin="0,18,0,0" FontSize="17" FontWeight="SemiBold" Foreground="#EDF4F7" />
                  <TextBlock Text="END VPN готов к работе" Margin="0,6,0,0" FontSize="12" Foreground="#8996A4" />
                </StackPanel>
              </Border>
            </Grid>

            <StackPanel Grid.Row="2">
              <CheckBox x:Name="AgreementCheckBox"
                        Style="{StaticResource AgreementCheckStyle}"
                        Checked="AgreementCheckBox_Changed"
                        Unchecked="AgreementCheckBox_Changed">
                <TextBlock TextWrapping="Wrap" LineHeight="18">Я прочитал правила, принимаю Публичную оферту и подтверждаю заключение договора на изложенных условиях.</TextBlock>
              </CheckBox>
              <Button x:Name="PrimaryButton" Margin="0,13,0,0" Content="ПРИНЯТЬ И УСТАНОВИТЬ" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" Click="PrimaryButton_Click" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>

  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
          <DoubleAnimation Storyboard.TargetName="BlueTransform" Storyboard.TargetProperty="X" From="-20" To="46" Duration="0:0:7.5" />
          <DoubleAnimation Storyboard.TargetName="BlueTransform" Storyboard.TargetProperty="Y" From="-12" To="30" Duration="0:0:8.5" />
          <DoubleAnimation Storyboard.TargetName="RedTransform" Storyboard.TargetProperty="X" From="22" To="-42" Duration="0:0:8" />
          <DoubleAnimation Storyboard.TargetName="RedTransform" Storyboard.TargetProperty="Y" From="18" To="-28" Duration="0:0:7" />
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>
</Window>
